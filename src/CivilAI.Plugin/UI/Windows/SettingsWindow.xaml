<Window x:Class="CivilAI.Plugin.UI.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Civil Settings"
        Width="560"
        Height="540"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="OpenAI API key" VerticalAlignment="Center" />
        <PasswordBox Grid.Row="0" Grid.Column="1" x:Name="ApiKeyBox" Margin="8,0,0,8" PasswordChanged="ApiKeyBox_OnPasswordChanged" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Primary model" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,8" Text="{Binding PrimaryModel, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Routing model" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" Margin="8,0,0,8" Text="{Binding RoutingModel, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Timeout [s]" VerticalAlignment="Center" />
        <TextBox Grid.Row="3" Grid.Column="1" Margin="8,0,0,8" Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Max output tokens" VerticalAlignment="Center" />
        <TextBox Grid.Row="4" Grid.Column="1" Margin="8,0,0,8" Text="{Binding MaxOutputTokens, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Confirmation policy" VerticalAlignment="Center" />
        <ComboBox Grid.Row="5" Grid.Column="1" Margin="8,0,0,8" SelectedValue="{Binding ConfirmationPolicyValue, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content">
            <ComboBoxItem Content="Always" />
            <ComboBoxItem Content="DestructiveOperations" />
            <ComboBoxItem Content="Never" />
        </ComboBox>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Dry run by default" VerticalAlignment="Center" />
        <CheckBox Grid.Row="6" Grid.Column="1" Margin="8,0,0,8" IsChecked="{Binding DryRunByDefault}" />

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Enable native command bridge" VerticalAlignment="Center" />
        <CheckBox Grid.Row="7" Grid.Column="1" Margin="8,0,0,8" IsChecked="{Binding EnableNativeCommandBridge}" />

        <TextBlock Grid.Row="8" Grid.Column="0" Text="Allow uncataloged commands" VerticalAlignment="Center" />
        <CheckBox Grid.Row="8" Grid.Column="1" Margin="8,0,0,8" IsChecked="{Binding AllowUncatalogedNativeCommands}" />

        <TextBlock Grid.Row="9" Grid.ColumnSpan="2" Text="API keys are persisted per-user using Windows DPAPI. Native command bridge lets AI queue Civil 3D commands/macros when a workflow is not covered by the managed API wrapper." TextWrapping="Wrap" Margin="0,8,0,8" />

        <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Width="100" Margin="0,0,8,0" Command="{Binding SaveSettingsCommand}" IsDefault="True" />
            <Button Content="Close" Width="100" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
