<UserControl x:Class="CivilAI.Plugin.UI.Controls.AssistantControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             MinWidth="420"
             MinHeight="680">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="160" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" />
            <RowDefinition Height="140" />
            <RowDefinition Height="140" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#102840" Padding="10" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="AI Civil Assistant" FontSize="20" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="Prompt-driven execution for AutoCAD and Civil 3D 2026." Foreground="#D8E7F5" />
                <TextBlock Text="{Binding Status}" Foreground="#7CFCB2" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Prompt" FontWeight="SemiBold" />
            <TextBox Grid.Row="1" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="0,6,0,0" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Analyze Drawing" Command="{Binding AnalyzeDrawingCommand}" Margin="0,0,8,0" Padding="12,6" />
                <Button Content="Dry Run" Command="{Binding BuildPlanCommand}" Margin="0,0,8,0" Padding="12,6" />
                <Button Content="Execute" Command="{Binding ExecutePlanCommand}" Padding="12,6" />
            </StackPanel>
        </Grid>

        <GroupBox Grid.Row="2" Margin="0,12,0,0" Header="Context">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding CurrentDrawingSummary}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Text="{Binding SelectionSummary}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Grid.Row="2" Text="{Binding ScopeSummary}" Margin="0,6,0,0" />
            </Grid>
        </GroupBox>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="Conversation" Margin="0,0,6,0">
                <ListBox ItemsSource="{Binding Conversation}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding Role}" FontWeight="Bold" />
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Plan">
                <DataGrid ItemsSource="{Binding PlannedSteps}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40" />
                        <DataGridTextColumn Header="Tool" Binding="{Binding ToolName}" Width="150" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="Tool Calls" Margin="0,0,6,0">
                <ListBox ItemsSource="{Binding ToolHistory}" />
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Modified Objects">
                <ListBox ItemsSource="{Binding ModifiedObjects}" />
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="5" Margin="0,12,0,0" Header="Validation &amp; Controls">
            <DockPanel Margin="8">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="Confirm / Execute" Command="{Binding ExecutePlanCommand}" Padding="10,5" Margin="0,0,8,0" />
                    <Button Content="Rollback" Command="{Binding RollbackCommand}" Padding="10,5" Margin="0,0,8,0" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="10,5" />
                </StackPanel>
                <ListBox ItemsSource="{Binding ValidationMessages}" />
            </DockPanel>
        </GroupBox>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Settings" Command="{Binding SaveSettingsCommand}" Padding="10,5" />
        </StackPanel>
    </Grid>
</UserControl>
